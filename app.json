{
  "expo": {
    "name": "Pat on Sports",
    "slug": "pat-on-sports",
    "owner": "pkeenan87s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "patonsports",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ae5408fc-cf1a-471f-9134-bd65dcef4efd"
    },
    "extra": {
      "eas": {
        "projectId": "ae5408fc-cf1a-471f-9134-bd65dcef4efd"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patonsports.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c2340",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.patonsports.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f7f5f1"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableMicrophonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
